{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legion-12.local/faq.schema.json",
  "title": "FaqEntry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "question",
    "answer",
    "relatedCardIds",
    "keywords",
    "source"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "question": {
      "type": "string"
    },
    "answer": {
      "type": "string"
    },
    "relatedCardIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source": {
      "type": "string"
    }
  }
}
